{
  "name": "huashan-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "element-plus": "2.11.5",
    "pinia": "3.0.3",
    "vue": "3.5.45",
    "vue-router": "4.6.3"
  },
  "overrides": {
    "vite": "$vite"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.1.1"
  }
}
